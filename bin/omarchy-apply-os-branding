#!/bin/bash

# omarchy:summary=Apply Ve OS display identity while preserving the base distribution
# omarchy:group=apply
# omarchy:requires-sudo=true
# omarchy:hidden=true

set -euo pipefail

if (( $# )); then
  echo "Usage: omarchy apply os-branding" >&2
  exit 1
fi

export PATH=/usr/bin:/usr/sbin:/bin:/sbin

exec /usr/bin/python3 -I - "${BASH_SOURCE[0]}" <<'PYTHON'
import os
from pathlib import Path
import runpy
import sys

entrypoint = Path(sys.argv[1]).resolve(strict=True)
source = Path("/usr/share/omarchy") if entrypoint == Path("/usr/bin/omarchy-apply-os-branding") else entrypoint.parent.parent
configured = os.environ.get("OMARCHY_PATH")
if configured and Path(configured).resolve() != source:
  raise SystemExit("OMARCHY_PATH does not match this Ve OS command")
runpy.run_path(str(source / "install/helpers/os-branding.py"), run_name="__main__")
PYTHON
