#!/bin/bash

# omarchy:summary=Sync Ve OS theme to all Obsidian vaults
# omarchy:hidden=true

CURRENT_THEME_DIR="$HOME/.local/state/omarchy/current/theme"

[[ -f $CURRENT_THEME_DIR/obsidian.css ]] || exit 0

jq -r '.vaults | values[].path' ~/.config/obsidian/obsidian.json 2>/dev/null | while read -r vault_path; do
  [[ -d $vault_path/.obsidian ]] || continue

  theme_dir="$vault_path/.obsidian/themes/Ve OS"
  mkdir -p "$theme_dir" || continue

  cat >"$theme_dir/manifest.json" <<'EOF' || continue
{
  "name": "Ve OS",
  "version": "1.0.0",
  "minAppVersion": "0.16.0",
  "description": "Automatically syncs with your current Ve OS system theme colors and fonts",
  "author": "Omarchy",
  "authorUrl": "https://omarchy.org"
}
EOF

  cp "$CURRENT_THEME_DIR/obsidian.css" "$theme_dir/theme.css" || continue

  appearance="$vault_path/.obsidian/appearance.json"
  if [[ -f $appearance ]] && jq -e '.cssTheme == "Omarchy"' "$appearance" >/dev/null 2>&1; then
    appearance_tmp=$(mktemp "$appearance.XXXXXX")
    if jq '.cssTheme = "Ve OS"' "$appearance" >"$appearance_tmp"; then
      mv "$appearance_tmp" "$appearance"
    else
      rm -f "$appearance_tmp"
    fi
  fi
done
